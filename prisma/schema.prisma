// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Subscription {
  FREE
  PRO
  ELITE
}

enum Marketplace {
  CSFLOAT
  STEAM
  SKINPORT
  DMARKET
  BUFF163
  WAXPEER
}

enum AlertChannel {
  DISCORD
  EMAIL
  IN_APP
}

enum AlertStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  image        String?
  emailVerified DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  subscription Subscription @default(FREE)
  apiKeys      ApiKey[]
  scanConfigs  ScanConfig[]
  alerts       Alert[]
  accounts     Account[]
  sessions     Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ApiKey {
  id           String      @id @default(cuid())
  userId       String
  marketplace  Marketplace
  encryptedKey String
  iv           String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ScanConfig {
  id          String      @id @default(cuid())
  userId      String
  name        String
  isActive    Boolean     @default(true)
  marketplace Marketplace
  interval    Int         @default(60)
  filters     Json
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  results     ScanResult[]
}

model ScanResult {
  id           String     @id @default(cuid())
  scanConfigId String
  marketplace  Marketplace
  itemName     String
  price        Float
  floatValue   Float?
  patternId    Int?
  phase        String?
  stickers     Json?
  listingUrl   String
  imageUrl     String?
  isStatTrak   Boolean    @default(false)
  isSouvenir   Boolean    @default(false)
  detectedAt   DateTime   @default(now())
  alertSent    Boolean    @default(false)
  scanConfig   ScanConfig @relation(fields: [scanConfigId], references: [id], onDelete: Cascade)
  alerts       Alert[]
}

model Alert {
  id           String      @id @default(cuid())
  userId       String
  scanResultId String
  channel      AlertChannel
  status       AlertStatus @default(PENDING)
  sentAt       DateTime?
  createdAt    DateTime    @default(now())
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scanResult   ScanResult  @relation(fields: [scanResultId], references: [id], onDelete: Cascade)
}
